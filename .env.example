# Casper Network Configuration
NEXT_PUBLIC_CASPER_NETWORK=testnet
NEXT_PUBLIC_CSPR_CLOUD_API_KEY=your_cspr_cloud_api_key_here

# AI Analysis — provider priority is OpenAI -> Claude -> heuristic demo.
# Set EITHER OpenAI or Anthropic for live AI (OpenAI takes priority if both set).
OPENAI_API_KEY=your_openai_api_key_here
# Optional: defaults to gpt-4o-mini. Use gpt-4o for higher quality.
OPENAI_MODEL=gpt-4o-mini
# Anthropic Claude (alternative provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# x402 Configuration
# Recipient for x402 payment intents (must be a real 01…/02… public key).
# Leave unset to default to the live agent wallet. Do NOT use a placeholder —
# invalid recipients cause native settle to fail with "Invalid purse".
NEXT_PUBLIC_X402_RECIPIENT=

# Optional: CSPR.cloud x402 HTTP facilitator for EIP-712 settle
# https://x402-facilitator.cspr.cloud — requires API key + signed payment payload.
# When unset, the agent wallet settles a real 0.01 CSPR native transfer on Testnet.
X402_FACILITATOR_URL=
# X402_FACILITATOR_API_KEY=

# Smart Contract (deployed on Casper Testnet — see README on-chain proof table)
PORTFOLIO_AGENT_PACKAGE_HASH=2f76596281bab4993440f5bd88728a34faa1031ab4b7ce8e0064219e1ae2e03d

# Agent On-Chain Writer (server-side only — fund a Casper Testnet key, then add its PEM or hex here)
# Use CASPER_AGENT_PRIVATE_KEY_PEM for PEM format, or CASPER_AGENT_PRIVATE_KEY_HEX for hex
CASPER_AGENT_PRIVATE_KEY_PEM=
CASPER_AGENT_PRIVATE_KEY_HEX=
# Must match chainspec: casper-test max_gas_price=1 (2+ is rejected as invalid pricing mode)
# CASPER_GAS_PRICE_TOLERANCE=1
# CASPER_AGENT_KEY_ALGORITHM=ed25519  # or secp256k1
# Native settle / rebalance amounts must be >= 2.5 CSPR (native_transfer_minimum_motes)
# X402_MICROPAYMENT_MOTES=2500000000
# REBALANCE_AMOUNT_MOTES=2500000000
